{
  "name": "keitaro-wrap-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit -p tsconfig.server.json && npm run build --workspace=keitaro-wrap-frontend",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "npm run lint --workspace=keitaro-wrap-frontend",
    "test": "npm run test --workspace=keitaro-wrap-frontend"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.8"
  }
}
